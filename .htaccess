RewriteEngine On

# Redirect old URLs with slug parameter to clean URLs
RewriteCond %{QUERY_STRING} ^slug=([^&]+)&ref=([^&]+) [NC]
RewriteRule ^article\.html$ /articles/%1? [R=301,L]

RewriteCond %{QUERY_STRING} ^slug=([^&]+) [NC]
RewriteRule ^psychology-article\.html$ /articles/%1? [R=301,L]

RewriteCond %{QUERY_STRING} ^slug=([^&]+) [NC]
RewriteRule ^article\.html$ /articles/%1? [R=301,L]

# Handle clean URLs by rewriting them back to the original article pages
RewriteRule ^articles/([^/]+)/?$ article.html?slug=$1 [L,QSA]

# Handle root-level article URLs (for psychology articles)
RewriteRule ^([a-z0-9-]+)/?$ psychology-article.html?slug=$1 [L,QSA]

# Additional rule to handle articles that might be in a different category
RewriteRule ^fraud/([^/]+)/?$ article.html?slug=$1 [L,QSA]

# For any other clean URL that doesn't match, try to handle as an article
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^/([a-z0-9-]+)/?$
RewriteRule ^.*$ article.html?slug=%1 [L,QSA]